---
import { type Lang, links } from '../../i18n/ui';
import * as d from '../../data/research';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="wrap">
  <div class="page-head">
    <h1>{d.head.title[lang]}</h1>
    <p>{d.head.lede[lang]}</p>
  </div>

  <div class="section">
    <p class="question">{d.question[lang]}</p>
    <dl class="meta">
      {d.meta.map((m) => (<><dt>{m.dt[lang]}</dt><dd>{m.dd[lang]}</dd></>))}
    </dl>
  </div>

  <div class="section">
    <h2 class="sec">{d.stepsTitle[lang]}</h2>
    <ol class="steps">
      {d.steps.map((s) => (
        <li class={s.now ? 'now' : undefined}><div><h3>{s.h[lang]}</h3><p>{s.p[lang]}</p></div></li>
      ))}
    </ol>
  </div>

  <div class="section">
    <h2 class="sec">{d.domainsTitle[lang]}</h2>
    <div class="dom-grid">
      {d.domains.map((c) => (
        <div class="dom-card" id={c.id}><h3>{c.h[lang]}</h3><p>{c.p[lang]}</p></div>
      ))}
    </div>
  </div>

  <div class="section" id="pubs">
    <h2 class="sec">Publications</h2>
    <article class="pub">
      <span class="venue">{d.pub.venue}</span>
      <h3>{d.pub.title}</h3>
      <p class="authors"><b>A. Fall</b>, {d.pub.authors.join(', ')}</p>
      <div class="row">
        <a class="btn" href={links.doiArise}>{d.pub.read[lang]}</a>
        <button class="btn" type="button" id="bib-btn">{d.pub.copy[lang]}</button>
        <span class="copied" id="bib-ok" hidden>{d.pub.copied[lang]}</span>
      </div>
      <pre id="bib">{d.pub.bib}</pre>
    </article>
  </div>

  <div class="section">
    <h2 class="sec">{d.teachingTitle[lang]}</h2>
    <dl class="meta">
      {d.teaching.map((m) => (
        <><dt>{m.dt[lang]}</dt><dd>{m.href ? <a href={m.href}>{m.dd[lang]}</a> : m.dd[lang]}</dd></>
      ))}
    </dl>
  </div>
</div>

<style>
  .question{font-size:clamp(24px,2.6vw,32px);line-height:1.3;letter-spacing:-.012em;font-weight:500;max-width:34ch;margin:0 0 20px}
  dl.meta{display:grid;grid-template-columns:max-content 1fr;gap:6px 24px;margin:0;font-size:16px}
  dl.meta dt{color:var(--graphite)}
  dl.meta dd{margin:0}
  .steps{list-style:none;margin:0;padding:0;counter-reset:s;display:grid;gap:0}
  .steps li{counter-increment:s;display:grid;grid-template-columns:48px minmax(0,1fr);gap:16px;padding:20px 0;border-top:1px solid var(--rule)}
  .steps li::before{content:counter(s);font:500 14px/1.9 var(--mono);color:var(--graphite)}
  .steps li.now::before{color:var(--trace)}
  .steps h3{margin:0 0 4px;font-size:var(--s1);font-weight:650}
  .steps p{margin:0;max-width:66ch;color:var(--graphite)}
  .dom-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .dom-card{border:1px solid var(--rule);padding:20px;scroll-margin-top:96px;transition:border-color .3s}
  .dom-card:target{border-color:var(--trace)}
  .dom-card h3{margin:0 0 8px;font-size:var(--s1);font-weight:650}
  .dom-card p{margin:0;font-size:16px;color:var(--graphite)}
  #pubs{scroll-margin-top:96px}
  #pubs:target .pub{border-color:var(--trace)}
  .pub{border:1px solid var(--rule);padding:22px;transition:border-color .3s}
  .pub .venue{font-size:14px;color:var(--graphite)}
  .pub h3{margin:6px 0 8px;font-size:var(--s2);font-weight:600;line-height:1.25;letter-spacing:-.01em}
  .pub .authors{margin:0 0 12px;font-size:16px}
  .pub .row{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
  .pub pre{margin:16px 0 0;padding:14px;background:var(--paper-2);overflow-x:auto;font:400 13px/1.55 var(--mono);white-space:pre}
  .copied{font-size:14px;color:var(--trace)}
  @media (max-width:960px){ .dom-grid{grid-template-columns:1fr} }
</style>

<script>
  const bib = document.getElementById('bib');
  const ok = document.getElementById('bib-ok');
  document.getElementById('bib-btn')?.addEventListener('click', () => {
    if (!bib || !ok) return;
    const done = () => { ok.hidden = false; setTimeout(() => (ok.hidden = true), 1800); };
    const fallback = () => {
      const s = getSelection(), rg = document.createRange();
      rg.selectNodeContents(bib); s?.removeAllRanges(); s?.addRange(rg);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(bib.textContent ?? '').then(done, fallback);
    else fallback();
  });
</script>
